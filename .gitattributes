# Auto detect text files and perform LF normalization
* text=auto

# Explicitly declare text files we want to normalize
*.css text
*.html text
*.js text
*.jsx text
*.json text
*.md text
*.ts text
*.tsx text
*.xml text
*.yml text

# Declare files that will always have CRLF line endings on checkout
*.sln text eol=crlf

# Denote all files that are truly binary and should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mov binary
*.mp4 binary
*.mp3 binary
*.flv binary
*.fla binary
*.swf binary
*.gz binary
*.zip binary
*.7z binary
*.ttf binary
*.eot binary
*.woff binary
*.woff2 binary
*.otf binary
